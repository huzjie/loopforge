# LoopForge 前端环境变量（复制为 .env.local 使用，不要提交真实密钥）
# API 基址（含 /api/v1 前缀）。生产由 nginx 同源反代，通常留空走相对路径。
VITE_API_BASE_URL=/api/v1

# WebSocket 事件端点。留空时自动推导为同源 /api/v1/ws/events。
VITE_WS_URL=

# 开发期 mock 开关：仅 VITE_USE_MOCK=true 且处于 vite dev 时生效，
# 让前端在无后端的情况下能渲染示例数据（生产构建不会启用）。
VITE_USE_MOCK=false

# 开发服务器代理目标（仅本地开发有效）。
VITE_PROXY_TARGET=http://127.0.0.1:8000
