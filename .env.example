# ============================================================================
# LoopForge 环境变量样例 —— 复制为 .env 后按需修改
#
# 命名规则：LOOPFORGE__<节>__<键>，双下划线表示嵌套层级。
# 配置覆盖顺序（后覆盖前）：
#   1. 代码默认值  2. config/default.yaml  3. $LOOPFORGE_CONFIG_FILE
#   4. 环境变量    5. .env 文件            6. 数据库热配置  7. CLI/API 单次参数
# ============================================================================

# ---- 配置文件位置 ----------------------------------------------------------
# LOOPFORGE_CONFIG_FILE=./loopforge.yaml

# ---- app -------------------------------------------------------------------
LOOPFORGE__APP__ENV=development
LOOPFORGE__APP__NAME=loopforge
LOOPFORGE__APP__TIMEZONE=UTC

# ---- db --------------------------------------------------------------------
# SQLite（默认，零依赖）
LOOPFORGE__DB__URL=sqlite+aiosqlite:///./data/loopforge.db
# PostgreSQL 16（生产）
# LOOPFORGE__DB__URL=postgresql+asyncpg://loopforge:loopforge@localhost:5432/loopforge
LOOPFORGE__DB__POOL_SIZE=10
LOOPFORGE__DB__MAX_OVERFLOW=20
LOOPFORGE__DB__ECHO=false

# ---- api -------------------------------------------------------------------
LOOPFORGE__API__HOST=0.0.0.0
LOOPFORGE__API__PORT=8080
LOOPFORGE__API__RATE_LIMIT_PER_MINUTE=600

# ---- security --------------------------------------------------------------
# Fernet 密钥，生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOOPFORGE__SECURITY__ENCRYPTION_KEY=
# 首次启动写入的 admin API Key（留空则自动生成并打印一次）
LOOPFORGE__SECURITY__BOOTSTRAP_KEY=

# ---- providers -------------------------------------------------------------
LOOPFORGE__PROVIDERS__DEFAULT=mock
LOOPFORGE__PROVIDERS__REQUEST_TIMEOUT_S=120
LOOPFORGE__PROVIDERS__MAX_RETRIES=4

# 各家 Key（仅在使用对应 Provider 时需要；默认 mock 模式全部留空即可）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- executor --------------------------------------------------------------
LOOPFORGE__EXECUTOR__KIND=local_subprocess
LOOPFORGE__EXECUTOR__WORKSPACE_ROOT=./data/workspaces
LOOPFORGE__EXECUTOR__COMMAND_TIMEOUT_S=300

# ---- memory ----------------------------------------------------------------
LOOPFORGE__MEMORY__MAX_CONTEXT_TOKENS=128000
LOOPFORGE__MEMORY__USAGE_RATIO=0.60

# ---- governance ------------------------------------------------------------
LOOPFORGE__GOVERNANCE__APPROVAL_TIMEOUT_S=3600
LOOPFORGE__GOVERNANCE__BUDGET__DEFAULT_RUN_LIMIT_USD=5.0
LOOPFORGE__GOVERNANCE__BUDGET__DEFAULT_DAY_LIMIT_USD=50.0

# ---- orchestration / lease -------------------------------------------------
LOOPFORGE__ORCHESTRATION__MAX_LOOPS=500
LOOPFORGE__LEASE__BASE_TTL_S=90
LOOPFORGE__LEASE__HEARTBEAT_INTERVAL_S=20

# ---- vcs -------------------------------------------------------------------
LOOPFORGE__VCS__PROVIDER=local_sandbox
LOOPFORGE__VCS__GITHUB__TOKEN=
LOOPFORGE__VCS__GITHUB__WEBHOOK_SECRET=

# ---- observability ---------------------------------------------------------
LOOPFORGE__OBSERVABILITY__LOG_FORMAT=console
LOOPFORGE__OBSERVABILITY__LOG_LEVEL=INFO
LOOPFORGE__OBSERVABILITY__METRICS_ENABLED=true

# ---- worker ----------------------------------------------------------------
LOOPFORGE__WORKER__CONCURRENCY=2
LOOPFORGE__WORKER__POLL_INTERVAL_S=2.0
